# ============================================================================
# AURELIA COLLECTION — BACKEND & CHATBOT LLM CONFIGURATION
# ============================================================================

# Server Settings
PORT=8000
FRONTEND_URL=http://localhost:3000

# ============================================================================
# CHATBOT LLM SETTINGS (Modul backend/llm/)
# ============================================================================
# Pilihan LLM_PROVIDER:
# - auto           : Otomatis pilih provider yang memiliki API key, atau fallback ke Smart RAG Concierge
# - smart_fallback : Built-in AI Concierge berbasis RAG real-time (Jalan langsung tanpa API Key!)
# - gemini         : Google Gemini API
# - openai         : OpenAI API (atau OpenRouter / DeepSeek)
# - groq           : Groq Cloud API (Llama 3.3 / Mixtral)
# - ollama         : Local LLM menggunakan Ollama

LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.4

# 1. Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# 2. OpenAI / Compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 3. Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 4. Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
